{
  "name": "skillcheck",
  "version": "0.1.0",
  "description": "Lint and eval harness for agent skills",
  "license": "MIT",
  "author": "undefined is not a function LLC",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "skillcheck": "src/cli.ts"
  },
  "files": [
    "src",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uinaf/skillcheck.git"
  },
  "homepage": "https://github.com/uinaf/skillcheck#readme",
  "bugs": {
    "url": "https://github.com/uinaf/skillcheck/issues"
  },
  "scripts": {
    "typecheck": "tsc --noEmit --strict --module nodenext --target es2023 --types node --skipLibCheck --allowImportingTsExtensions src/cli.ts src/lint.ts src/scenario.ts src/transform.ts test/cli.test.ts",
    "test": "node --test test/cli.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.233",
    "@openai/codex-sdk": "^0.147.0",
    "promptfoo": "^0.122.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
