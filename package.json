{
  "name": "@uinaf/skillcheck",
  "version": "0.4.0",
  "description": "Lint and eval harness for agent skills",
  "homepage": "https://github.com/uinaf/skillcheck#readme",
  "bugs": {
    "url": "https://github.com/uinaf/skillcheck/issues"
  },
  "license": "MIT",
  "author": "undefined is not a function LLC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uinaf/skillcheck.git"
  },
  "bin": {
    "skillcheck": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "verify": "vp check && vp pack && vp test run",
    "prepare": "vp config --no-agent",
    "prepublishOnly": "pnpm run verify"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.233",
    "@openai/codex-sdk": "^0.147.0",
    "@types/node": "^26.2.0",
    "promptfoo": "^0.122.0",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.233",
    "@openai/codex-sdk": "^0.147.0",
    "promptfoo": "^0.122.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    },
    "@openai/codex-sdk": {
      "optional": true
    },
    "promptfoo": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.22.0"
}
